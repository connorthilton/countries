<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Map of <%= country.country_name %> | Country Catalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container py-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h1 class="mb-0"><%= country.country_name %></h1>
            <a class="btn btn-outline-secondary" href="/countries">Back to Countries</a>
        </div>

        <p class="text-muted">
            Capital: <strong><%= country.capital %></strong>
            &nbsp;·&nbsp;
            Popular site: <strong><%= country.popular_site %></strong>
        </p>

        <div class="ratio ratio-16x9 shadow-sm rounded overflow-hidden">
            <iframe src="<%= mapUrl %>"
                    title="Map of <%= country.country_name %>"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    style="border: 0;"></iframe>
        </div>

    </div>

</body>
</html>

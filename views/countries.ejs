<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Countries | Country Catalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container py-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h1 class="mb-0">Countries</h1>
            <div>
                <a class="btn btn-outline-secondary" href="/">Home</a>
                <a class="btn btn-outline-secondary" href="/logout">Logout</a>
            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle bg-white">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Country</th>
                        <th>Popular Site</th>
                        <th>Capital</th>
                        <th class="text-end">Population</th>
                        <th class="text-center">Visited</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (countries.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No countries yet. Use "Add Country" below.
                            </td>
                        </tr>
                    <% } %>

                    <% countries.forEach(country => { %>
                        <tr>
                            <td><%= country.country_id %></td>
                            <td><%= country.country_name %></td>
                            <td><%= country.popular_site %></td>
                            <td><%= country.capital %></td>

                            <td class="text-end"><%= country.population.toLocaleString("en-US") %></td>

                            <td class="text-center"><%= country.visited ?? "—" %></td>

                            <td class="text-center text-nowrap">

                                <a class="btn btn-sm btn-primary"
                                   href="/editCountry/<%= country.country_id %>">Edit</a>

                                <form method="post"
                                      action="/deleteCountry/<%= country.country_id %>"
                                      class="d-inline"
                                      data-name="<%= country.country_name %>"
                                      onsubmit="return confirm('Delete ' + this.dataset.name + '? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>

                                <a class="btn btn-sm btn-success"
                                   href="/map/<%= country.country_id %>">Map</a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <a class="btn btn-success" href="/addCountry">+ Add Country</a>

    </div>

</body>
</html>

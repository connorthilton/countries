<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= heading %> | Country Catalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <h1 class="mb-3"><%= heading %></h1>

                <% if (errors.length > 0) { %>
                    <div class="alert alert-danger">
                        <strong>Please fix the following:</strong>
                        <ul class="mb-0">
                            <% errors.forEach(msg => { %>
                                <li><%= msg %></li>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>

                <form method="post" action="<%= action %>" class="card p-4 shadow-sm">

                    <div class="mb-3">
                        <label for="country_name" class="form-label">Country Name</label>
                        <input type="text" class="form-control" id="country_name" name="country_name"
                               maxlength="30" required
                               value="<%= country.country_name ?? '' %>">
                    </div>

                    <div class="mb-3">
                        <label for="popular_site" class="form-label">Popular Site</label>
                        <input type="text" class="form-control" id="popular_site" name="popular_site"
                               maxlength="50" required
                               value="<%= country.popular_site ?? '' %>">
                    </div>

                    <div class="mb-3">
                        <label for="capital" class="form-label">Capital</label>
                        <input type="text" class="form-control" id="capital" name="capital"
                               maxlength="30" required
                               value="<%= country.capital ?? '' %>">
                    </div>

                    <div class="mb-3">
                        <label for="population" class="form-label">Population</label>
                        <input type="number" class="form-control" id="population" name="population"
                               min="0" step="1" required
                               value="<%= country.population ?? '' %>">
                    </div>

                    <div class="mb-4">
                        <label for="visited" class="form-label">Visited?</label>
                        <select class="form-select" id="visited" name="visited">
                            <option value="" <%= !country.visited ? "selected" : "" %>>— Not specified —</option>
                            <option value="Y" <%= country.visited === "Y" ? "selected" : "" %>>Y — Yes</option>
                            <option value="N" <%= country.visited === "N" ? "selected" : "" %>>N — No</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><%= buttonText %></button>
                        <a class="btn btn-outline-secondary" href="/countries">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>

</body>
</html>

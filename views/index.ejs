<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Country Catalog</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container py-5">

        <h1 class="text-center mb-4">Country Catalog</h1>

        <div class="row align-items-center g-4">

            <div class="col-md-6 text-center">
                <img src="/images/Screenshot%202026-11-25%20180352.jpg"
                     alt="Country catalog landing image"
                     class="img-fluid rounded shadow">
            </div>

            <div class="col-md-6">

                <div class="card p-4 shadow-sm">

                    <% if (loggedIn) { %>

                        <h2 class="h4 mb-3">Welcome back!</h2>
                        <p>You're signed in. Manage the catalog below.</p>

                        <a class="btn btn-primary w-100 mb-2" href="/countries">Maintain Countries</a>

                        <a class="btn btn-outline-secondary w-100" href="/logout">Logout</a>

                    <% } else { %>

                        <h2 class="h4 mb-3">Sign in</h2>

                        <% if (error) { %>
                            <div class="alert alert-danger"><%= error %></div>
                        <% } %>

                        <form method="post" action="/login">

                            <div class="mb-3">
                                <label for="username" class="form-label">Username</label>
                                <input type="text" class="form-control" id="username" name="username" required>
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" class="form-control" id="password" name="password" required>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Sign In</button>
                        </form>

                    <% } %>

                </div>
            </div>
        </div>
    </div>

</body>
</html>
